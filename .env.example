# ═══════════════════════════════════════════════════════════════
# BIBLIOTECA IA — Variables de entorno del servidor
# Copia este archivo como .env y rellena cada valor
# NUNCA subas .env a GitHub (ya está en .gitignore)
# ═══════════════════════════════════════════════════════════════

# ── SUPABASE ────────────────────────────────────────────────────
# Dónde encontrarlos: supabase.com → tu proyecto → Settings → API
SUPABASE_URL=https://XXXXXXXXXXXXXXXX.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  # "service_role" key (NUNCA la pongas en el frontend)

# ── STRIPE ──────────────────────────────────────────────────────
# Dónde encontrarlos: dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...          # o sk_test_... para pruebas
STRIPE_WEBHOOK_SECRET=whsec_...        # Generado al crear el webhook en Stripe Dashboard

# ── RESEND ──────────────────────────────────────────────────────
# Dónde encontrarlo: resend.com → API Keys → Create API Key
RESEND_API_KEY=re_...

# ── CONFIGURACIÓN GENERAL ───────────────────────────────────────
# URL de tu web frontend (sin barra final)
# En desarrollo: http://localhost:5500 (o el puerto de tu Live Server)
# En producción: https://tudominio.com
FRONTEND_URL=http://localhost:5500

# Puerto donde corre el servidor (no necesitas cambiarlo normalmente)
PORT=3000
